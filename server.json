{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.AKzar1el/nofax",
  "title": "Nofax",
  "description": "Human-in-the-loop approvals and notifications for AI coding agents through a local stdio MCP server.",
  "repository": {
    "url": "https://github.com/AKzar1el/nofax",
    "source": "github"
  },
  "version": "0.2.11",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "nofax",
      "version": "0.2.11",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
